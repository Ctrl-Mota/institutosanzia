---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrgSchema from '../components/OrgSchema.astro';
import OrganicDivider from '../components/OrganicDivider.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import Depoimentos from '../components/Depoimentos.astro';
import ContactBlock from '../components/ContactBlock.astro';
import LibrasBanner from '../components/LibrasBanner.astro';
import Localizacao from '../components/Localizacao.astro';
import { categories } from '../data/services';
import { depoimentos } from '../data/depoimentos';
import { site, waLink } from '../data/site';

const pilares = categories.filter((c) => c.slug !== 'cursos-e-eventos');
const cursos = categories.find((c) => c.slug === 'cursos-e-eventos')!;
const libras = cursos.services[0]!;
const primeiroDepoimento = depoimentos[0]!;

const homeFaq = [
  {
    q: 'Não tenho diagnóstico nenhum. Posso procurar o Instituto?',
    a: 'Sim — é assim que a maioria das famílias chega. Você traz a preocupação, a gente avalia e explica o que está acontecendo. O diagnóstico, quando existe, é resultado desse processo, não requisito para começar.',
  },
  {
    q: 'Como sei qual profissional meu filho precisa?',
    a: 'Você não precisa saber. Essa é a nossa parte. Na primeira conversa entendemos a queixa e indicamos por onde começar — às vezes é uma avaliação, às vezes é uma orientação de poucos encontros.',
  },
  {
    q: 'Vocês atendem adultos ou só crianças?',
    // Reescrito a pedido dela (09/09). A resposta antiga listava quais serviços
    // atendem adultos, o que por omissão sugeria que os outros não, e não
    // mencionava idoso em lugar nenhum. O exemplo da aposentadoria é dela e é
    // o que faz a frase funcionar: sem ele, é só uma lista.
    a: 'Todas as idades, inclusive idosos. Muita gente supõe que idoso não precisa de psicoterapia ou de avaliação neuropsicológica, e não é raro ser o contrário: uma avaliação daqui já ajudou a instruir um pedido de aposentadoria.',
  },
  {
    q: 'A primeira conversa tem custo?',
    a: 'Fale com a gente pelo WhatsApp: explicamos como funciona o primeiro contato e os valores antes de você marcar qualquer coisa.',
  },
  {
    q: 'Onde o Instituto fica?',
    a: `${site.address.street}, ${site.address.district}, ${site.address.cityShort}. O endereço completo e a rota estão na seção "Onde ficamos", no fim desta página.`,
  },
];
---
<BaseLayout
  title={`${site.name} — psicologia, terapias e apoio educacional`}
  description={site.description}
  path="/"
  waOrigin="os atendimentos do Instituto"
>
  <OrgSchema slot="head" />

  <!-- ───────────────────────────── Hero ───────────────────────────── -->
  <section class="hero" aria-labelledby="home-titulo">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <!-- Frase escrita por ela e pedida em 21/09, palavra por palavra.
             A razão, no áudio do mesmo dia: "fiquei pensativa só nessa frase,
             que de fato atende todas as idades" — o título anterior dizia
             "seu filho" e excluía o público adulto e idoso que ela havia
             pedido para incluir em 09/09.

             O custo é conhecido: a versão anterior nomeava o público e o
             desfecho, o que converte melhor. Esta é mais ampla. A decisão é
             dela e é coerente com o resto do site; se um dia quiser testar as
             duas, é este bloco que muda. -->
        <h1 id="home-titulo">
          A gente ajuda você e sua família a compreender cada fase da vida e
          encontrar o apoio necessário.
        </h1>
        <p class="lede hero__lede">
          Psicologia, terapias de desenvolvimento e apoio educacional reunidos
          em {site.address.cityShort}, numa equipe que conversa entre si. Você conta
          o que está acontecendo e a gente indica por onde começar, antes de
          você marcar qualquer coisa.
        </p>
        <!-- Um CTA dominante. O secundário virou link de texto para não
             competir pelo clique. -->
        <div class="hero__actions">
          <a class="btn btn--wa" href={waLink('os atendimentos do Instituto')} target="_blank" rel="noopener">
            Contar o que está acontecendo
          </a>
          <a class="hero__alt" href="#servicos">ou ver os serviços primeiro</a>
        </div>
        <p class="hero__note">
          Se o caminho não for aqui, a gente diz e orienta para onde ir.
        </p>
      </div>

      <div class="hero__media">
        <Photo
          src="sala-com-brinquedos.jpeg"
          alt="Sala de atendimento do Instituto com a mesa preparada para psicomotricidade: cones, discos de equilíbrio, marcadores de mão e pé, bolas com textura e um rolo colorido"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Prova social imediatamente abaixo da primeira dobra: reforça confiança
       antes de a pessoa precisar rolar atrás dela. Texto, não vídeo — não
       custa byte nenhum. -->
  <aside class="prova" aria-label="Depoimento de uma mãe atendida">
    <div class="wrap prova__inner">
      <blockquote class="prova__quote">{primeiroDepoimento.destaque}</blockquote>
      <p class="prova__quem">
        <b>{primeiroDepoimento.quem}</b>, {primeiroDepoimento.contexto}
        <a class="prova__link" href="#depoimentos">ver os relatos em vídeo</a>
      </p>
    </div>
  </aside>

  <LibrasBanner />

  <!-- ─────────────────────── Os três pilares ─────────────────────── -->
  <section id="servicos" class="pilares section" aria-labelledby="pilares-titulo">
    <div class="wrap">
      <div class="pilares__head measure">
        <h2 id="pilares-titulo">Três frentes de cuidado e uma formação aberta</h2>
        <p class="lede">
          Cada frente reúne os serviços que se apoiam entre si. Clique para ler
          sobre um serviço específico.
        </p>
      </div>

      <div class="grid grid--3 pilares__grid">
        {
          pilares.map((c) => (
            <article class="card pilar">
              <h3><a href={`/${c.slug}`}>{c.title}</a></h3>
              <p class="pilar__promise">{c.promise}</p>
              <ul class="pilar__list">
                {
                  c.services.map((s) => (
                    <li>
                      <a href={`/${c.slug}#${s.id}`}>{s.name}</a>
                    </li>
                  ))
                }
              </ul>
              <a class="pilar__more" href={`/${c.slug}`}>Conhecer {c.navLabel}</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <OrganicDivider bg="var(--grey-50)" fill="var(--navy)" />

  <!-- ───────────────────────── Curso de Libras ───────────────────────── -->
  <section class="libras" aria-labelledby="libras-titulo">
    <div class="wrap libras__grid">
      <div class="libras__text">
        <h2 id="libras-titulo">{libras.name}</h2>
        <p class="libras__answer">{libras.answer}</p>
        <div class="libras__actions">
          <a class="btn libras__solid" href={`/${cursos.slug}#${libras.id}`}>
            Ver o curso
          </a>
          <a class="btn btn--ghost libras__ghost" href={waLink(libras.name, libras.waMessage)} target="_blank" rel="noopener">
            Fazer a inscrição
          </a>
        </div>
      </div>
      <!-- Aqui havia um placeholder de foto de turma. Foto de aula de Libras
           precisa de rosto e mão de aluno real, com autorização — e uma imagem
           genérica pesaria contra justamente neste bloco. Enquanto a foto não
           existe, o espaço carrega informação: para quem o curso é. -->
      <div class="libras__media">
        <div class="libras__para">
          <h3>Para quem é</h3>
          <ul class="checks">
            {libras.forWhom?.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <OrganicDivider bg="var(--navy)" fill="var(--grey-25)" flip />

  <!-- ─────────────────────── Como começa ─────────────────────── -->
  <section class="passos section" aria-labelledby="passos-titulo">
    <div class="wrap">
      <div class="passos__head measure">
        <h2 id="passos-titulo">Como funciona o primeiro contato</h2>
        <p class="lede">
          Procurar ajuda para um filho já é difícil o bastante. O processo aqui é
          simples e você sabe o que esperar em cada etapa.
        </p>
      </div>

      <ol class="passos__list">
        <li class="passo">
          <span class="passo__num" aria-hidden="true">1</span>
          <h3>Você conta o que está acontecendo</h3>
          <p>
            Pelo WhatsApp, no seu tempo e com as palavras que tiver. Não precisa
            usar termo técnico nem ter clareza do problema.
          </p>
        </li>
        <li class="passo">
          <span class="passo__num" aria-hidden="true">2</span>
          <h3>A gente indica por onde começar</h3>
          <p>
            Explicamos qual profissional faz sentido, quanto tempo leva e quanto
            custa — antes de você marcar qualquer coisa.
          </p>
        </li>
        <li class="passo">
          <span class="passo__num" aria-hidden="true">3</span>
          <h3>O plano é montado com você</h3>
          <p>
            Metas escritas, revisadas periodicamente, com devolutivas em
            linguagem clara. Você acompanha a evolução, não só o boleto.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ─────────────────────── Diferenciais ─────────────────────── -->
  <section class="valores" aria-labelledby="valores-titulo">
    <div class="wrap valores__grid">
      <div class="valores__text">
        <h2 id="valores-titulo">Cuidado técnico, sem pressa e sem pressão</h2>
        <ul class="checks valores__list">
          <li>
            <strong>Equipe multidisciplinar no mesmo lugar.</strong> Psicologia,
            terapia ocupacional, psicopedagogia e ABA conversando entre si — sem
            você repetir a mesma história em cinco lugares diferentes.
          </li>
          <li>
            <strong>Plano com metas escritas.</strong> Você sabe o que está sendo
            trabalhado, por quê, e como está evoluindo.
          </li>
          <li>
            <strong>Articulação com a escola.</strong> Com a sua autorização,
            falamos com quem convive com a criança todos os dias.
          </li>
          <li>
            <strong>Acessibilidade como princípio.</strong> Ensinamos Libras e
            atendemos pessoas com deficiência — dentro e fora do site.
          </li>
        </ul>
      </div>

      <div class="valores__media">
        <Photo
          src="espaco-sala-1.jpg"
          alt="Sala de atendimento do Instituto: mesa clara, duas cadeiras, prateleiras de madeira e uma planta"
          ratio="4 / 3"
        />
        <Photo
          src="espaco-sala-2.jpg"
          alt="Mesa de atendimento com prateleiras de madeira, um quadro do mar e um cavalete com tela em branco"
          ratio="4 / 3"
        />
      </div>
    </div>
  </section>

  <Depoimentos />

  <Faq items={homeFaq} title="Perguntas frequentes" />

  <Localizacao />

  <OrganicDivider bg="var(--grey-25)" fill="var(--navy)" />

  <ContactBlock
    origin="os atendimentos do Instituto"
    title="Conte o que está acontecendo."
    text="A gente escuta, explica o que é possível fazer e indica o próximo passo — mesmo que o próximo passo não seja aqui."
  />
</BaseLayout>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    background: var(--grey-25);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero h1 { max-width: 30ch; }
  .hero__lede { margin-top: var(--sp-5); }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
  }
  /* Link de texto, não botão: o CTA principal fica sozinho na hierarquia. */
  .hero__alt {
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .hero__alt:hover { color: var(--navy); }

  .hero__note {
    margin-top: var(--sp-5);
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: 34rem;
  }

  /* ---------------- Prova social sob a primeira dobra ---------------- */
  .prova {
    background: var(--white);
    border-block: 1px solid var(--line);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }
  .prova__inner { max-width: 56rem; }
  .prova__quote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    line-height: 1.45;
    color: var(--navy);
  }
  .prova__quote::before { content: '“'; }
  .prova__quote::after { content: '”'; }
  .prova__quem {
    margin-top: var(--sp-3);
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .prova__quem b { color: var(--navy); font-weight: 600; }
  .prova__link { margin-left: var(--sp-3); white-space: nowrap; }
  .hero__media :global(.photo) { box-shadow: var(--sh-2); }

  /* ---------------- Pilares ---------------- */
  .pilares { background: var(--grey-50); }
  .pilares__grid { margin-top: var(--sp-7); }

  .pilar { display: flex; flex-direction: column; }
  .pilar h3 { font-size: var(--fs-h3); }
  .pilar h3 a { color: var(--navy); text-decoration: none; }
  .pilar h3 a:hover { color: var(--teal-700); text-decoration: underline; }
  .pilar__promise {
    margin-top: var(--sp-3);
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .pilar__list {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-1);
    border-top: 1px solid var(--line);
    padding-top: var(--sp-4);
  }
  .pilar__list a {
    display: block;
    padding: 0.35rem 0;
    text-decoration: none;
    color: var(--navy);
    font-size: 0.9375rem;
  }
  .pilar__list a:hover { color: var(--teal-700); text-decoration: underline; }
  .pilar__more {
    margin-top: auto;
    padding-top: var(--sp-5);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .pilar__more:hover { text-decoration: underline; }

  /* ---------------- Libras ---------------- */
  .libras {
    background: var(--navy);
    color: #fff;
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .libras__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .libras h2 { color: #fff; font-size: var(--fs-h1); }
  .libras__answer {
    margin-top: var(--sp-5);
    color: #d3dee7;
    font-size: var(--fs-lg);
    line-height: 1.6;
  }
  .libras__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
  }
  .libras__para {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--r-md);
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }
  .libras__para h3 { color: #fff; font-size: 1.0625rem; }
  .libras__para :global(.checks) { margin-top: var(--sp-4); }
  .libras__para :global(.checks li) { color: #d6e1ea; }
  .libras__para :global(.checks li::before) {
    background: rgba(255, 255, 255, 0.16);
    border-color: #93bcc6;
  }

  .libras__solid { background: #fff; color: var(--navy); }
  .libras__solid:hover { background: var(--teal-100); color: var(--navy-900); }
  .libras__ghost { color: #fff; border-color: rgba(255, 255, 255, 0.4); }
  .libras__ghost:hover { background: rgba(255, 255, 255, 0.1); color: #fff; border-color: #fff; }

  /* ---------------- Passos ---------------- */
  .passos { background: var(--grey-25); }
  .passos__list {
    list-style: none;
    margin: var(--sp-7) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .passo h3 { font-size: var(--fs-h4); margin-top: var(--sp-4); }
  .passo p { margin-top: var(--sp-3); color: var(--muted); font-size: 0.9688rem; }
  .passo__num {
    display: grid;
    place-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-pill);
    background: var(--teal-100);
    color: var(--navy);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
  }

  /* ---------------- Valores ---------------- */
  .valores { background: var(--grey-100); padding-block: var(--section-y); }
  .valores__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .valores__list { margin-top: var(--sp-6); gap: var(--sp-4); }
  .valores__list strong { color: var(--navy); font-weight: 600; }
  .valores__media { display: grid; gap: var(--sp-4); }

  /* ---------------- Responsivo ---------------- */
  @media (max-width: 62rem) {
    .hero__grid,
    .libras__grid,
    .valores__grid { grid-template-columns: 1fr; }
    .hero__media { order: -1; max-width: 26rem; }
    .valores__media { grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr)); }
  }
</style>
