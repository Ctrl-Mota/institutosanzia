---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnchorNav from '../components/AnchorNav.astro';
import ServiceSection from '../components/ServiceSection.astro';
import Faq from '../components/Faq.astro';
import ContactBlock from '../components/ContactBlock.astro';
import TurmaAberta from '../components/TurmaAberta.astro';
import OrganicDivider from '../components/OrganicDivider.astro';
import { categories } from '../data/services';
import { site } from '../data/site';

export function getStaticPaths() {
  return categories.map((c) => ({
    params: { category: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const path = `/${category.slug}`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: site.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: category.title,
      item: `${site.url}${path}`,
    },
  ],
};
---
<BaseLayout
  title={`${category.metaTitle} | ${site.name}`}
  description={category.metaDescription}
  path={path}
  waOrigin={category.title}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumb)}
  />

  <!-- Hero curto: promessa da categoria e nada mais. -->
  <section class="hero" aria-labelledby="pagina-titulo">
    <div class="wrap hero__inner">
      <nav class="crumbs" aria-label="Trilha de navegação">
        <a href="/">Início</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{category.navLabel}</span>
      </nav>
      <h1 id="pagina-titulo">{category.title}</h1>
      <p class="hero__promise">{category.promise}</p>
      {category.heroSupport && <p class="lede hero__support">{category.heroSupport}</p>}
    </div>
  </section>

  <AnchorNav services={category.services} />

  {category.slug === 'cursos-e-eventos' && <TurmaAberta />}

  {
    category.services.map((service, i) => (
      <ServiceSection service={service} categorySlug={category.slug} index={i} />
    ))
  }

  <Faq items={category.faq} title={`Perguntas frequentes sobre ${category.navLabel}`} />

  <OrganicDivider bg="var(--grey-50)" fill="var(--navy)" />

  <ContactBlock origin={category.title} />
</BaseLayout>

<style>
  .hero {
    background: var(--grey-25);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }
  .hero__inner { max-width: 52rem; }

  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: var(--sp-5);
  }
  .crumbs a { color: var(--teal-700); }

  .hero__promise {
    margin-top: var(--sp-5);
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    line-height: 1.42;
    color: var(--navy-600);
  }
  .hero__support { margin-top: var(--sp-4); font-size: 1.0625rem; }
</style>
