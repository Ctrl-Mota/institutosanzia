---
import fs from 'node:fs';
import path from 'node:path';
import { imageSize } from '../lib/image-size';

/**
 * Foto do espaço real do Instituto.
 * Enquanto o arquivo não existe em public/img/, renderiza um placeholder
 * identificado — o layout não quebra e fica claro qual foto falta.
 * Quando a foto chegar, basta salvar com o nome esperado.
 */
interface Props {
  /** nome do arquivo em public/img/ — ex.: 'espaco-sala-1.jpg' */
  src: string;
  alt: string;
  /**
   * Proporção CSS. Por padrão vem das dimensões reais do arquivo — só passe
   * um valor aqui para recortar de propósito.
   */
  ratio?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { src, alt, ratio, loading = 'lazy', class: className } = Astro.props;

const abs = path.join(process.cwd(), 'public', 'img', src);
const exists = fs.existsSync(abs);

if (!exists) {
  console.warn(`[foto ausente] public/img/${src} — "${alt}"`);
}

// Dimensões lidas do arquivo: alimentam width/height (contra layout shift) e a
// proporção padrão, para uma foto trocada nunca sair recortada por engano.
const size = exists ? imageSize(abs) : null;
if (exists && !size) {
  console.warn(`[foto ilegível] não consegui ler as dimensões de public/img/${src}`);
}

const proporcao = ratio ?? (size ? `${size.width} / ${size.height}` : '4 / 3');

// A foto do hero é o maior elemento da primeira dobra — o LCP. A dica de
// prioridade tira o atraso de descoberta que atrasa a primeira impressão.
const prioridade = loading === 'eager';
---
{
  exists ? (
    <img
      class:list={['photo', className]}
      src={`/img/${src}`}
      alt={alt}
      width={size?.width}
      height={size?.height}
      loading={loading}
      decoding="async"
      fetchpriority={prioridade ? 'high' : undefined}
      style={`aspect-ratio:${proporcao}`}
    />
  ) : (
    <div
      class:list={['photo photo--todo', className]}
      style={`aspect-ratio:${proporcao}`}
      role="img"
      aria-label={alt}
    >
      <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" focusable="false">
        <path d="M3 5.5h18v13H3z" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="8.5" cy="10" r="1.6" fill="currentColor"/>
        <path d="M4 17l5-5 4 3.5 3-2.5 4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
      <span class="photo__todo">Foto a receber<br /><code>{src}</code></span>
    </div>
  )
}

<style>
  .photo {
    width: 100%;
    border-radius: var(--r-lg);
    object-fit: cover;
    background: var(--grey-100);
  }
  .photo--todo {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--sp-3);
    padding: var(--sp-5);
    text-align: center;
    color: var(--muted);
    background:
      repeating-linear-gradient(
        135deg,
        var(--grey-100) 0 12px,
        color-mix(in srgb, var(--grey-100) 82%, var(--teal)) 12px 24px
      );
    border: 1px dashed var(--line);
  }
  .photo__todo { font-size: 0.8125rem; line-height: 1.5; }
  .photo__todo code {
    font-size: 0.75rem;
    color: var(--navy);
    background: rgba(255, 255, 255, 0.6);
    padding: 1px 5px;
    border-radius: 4px;
  }
</style>
