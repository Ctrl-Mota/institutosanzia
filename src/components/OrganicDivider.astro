---
// Uma curva só, usada em todas as divisões — uma forma reconhecível lê como
// assinatura; três variantes leem como biblioteca de ondas.
// `bg` = cor da seção acima, `fill` = cor da seção abaixo.
// `flip` espelha a curva, para o par de entrada e saída de uma faixa.
interface Props {
  bg?: string;
  fill?: string;
  flip?: boolean;
  height?: number;
}
const {
  bg = 'var(--grey-50)',
  fill = 'var(--navy)',
  flip = false,
  height = 104,
} = Astro.props;

const curva =
  'M0,64 C240,8 420,96 720,64 C1020,32 1200,8 1440,44 L1440,120 L0,120 Z';
---
<div class="divider" style={`--dv-bg:${bg}; --dv-h:${height}px;`} aria-hidden="true">
  <svg
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    focusable="false"
    class:list={[flip && 'is-flipped']}
  >
    <path d={curva} fill={fill} />
  </svg>
</div>

<style>
  .divider {
    background: var(--dv-bg);
    line-height: 0;
  }
  .divider svg {
    display: block;
    width: 100%;
    height: var(--dv-h);
  }
  .divider svg.is-flipped { transform: scaleX(-1); }
</style>
