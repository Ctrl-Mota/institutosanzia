---
import { waLink } from '../data/site';

interface Props {
  /** Origem do contato — entra na mensagem pré-preenchida. */
  origin: string;
}
const { origin } = Astro.props;
---
<a
  class="wa-float no-print"
  href={waLink(origin)}
  target="_blank"
  rel="noopener"
>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.09c-.24.68-1.42 1.31-1.96 1.36-.54.05-1.05.24-3.53-.74-2.98-1.18-4.86-4.28-5.01-4.48-.15-.2-1.19-1.6-1.19-3.05 0-1.45.75-2.16 1.02-2.46.27-.3.59-.37.79-.37.2 0 .39 0 .57.01.18.01.42-.07.66.5.24.58.83 2.02.9 2.17.07.15.12.32.02.52-.1.2-.19.32-.39.5-.2.18-.31.29-.44.49-.13.2-.28.44-.08.79.2.35.66 1.19 1.44 1.9.99.91 1.79 1.2 2.06 1.33.27.13.51.11.7-.06.19-.17.83-.86 1.05-1.16.22-.3.43-.24.71-.13.28.11 1.74.87 2.04 1.02.3.15.5.23.57.35.07.12.07.7-.17 1.38Z"
    />
  </svg>
  <span class="wa-float__text">Tirar uma dúvida no WhatsApp</span>
</a>

<style>
  /* Discreto e imóvel. Nada de pulsar, chamar atenção ou criar urgência. */
  .wa-float {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 70;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    padding: 0.8rem 1.25rem;
    border-radius: var(--r-pill);
    background: var(--wa);
    color: #fff;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
    box-shadow: var(--sh-2);
    transition: background-color 160ms ease;
  }
  .wa-float:hover { background: #175f42; color: #fff; }

  @media (max-width: 48rem) {
    /* No mobile fica só o ícone, para não cobrir o conteúdo. */
    .wa-float { padding: 0.9rem; }
    .wa-float__text {
      position: absolute; width: 1px; height: 1px;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
    }
  }
</style>
