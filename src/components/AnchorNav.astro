---
import type { Service } from '../data/services';

interface Props {
  services: Service[];
}
const { services } = Astro.props;
---
<nav class="anchors no-print" aria-label="Serviços desta página">
  <div class="wrap">
    <p class="anchors__hint" id="anchors-hint">Nesta página</p>
    <ul aria-labelledby="anchors-hint">
      {
        services.map((s) => (
          <li>
            <a href={`#${s.id}`} data-anchor={s.id}>{s.name}</a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .anchors {
    position: sticky;
    top: var(--header-h);
    z-index: 50;
    background: var(--grey-50);
    border-block: 1px solid var(--line);
  }
  .anchors .wrap {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    padding-block: var(--sp-3);
  }
  .anchors__hint {
    flex: none;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
    margin: 0;
  }
  .anchors ul {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .anchors li { flex: none; }
  .anchors a {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: var(--r-pill);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .anchors a:hover { background: var(--white); border-color: var(--line); }
  .anchors a[data-active='true'] {
    background: var(--navy);
    color: #fff;
  }

  @media (max-width: 60rem) {
    .anchors__hint { display: none; }
    .anchors .wrap { padding-inline: clamp(1.25rem, 5vw, 2.5rem); }
  }
</style>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.anchors a[data-anchor]'),
  );
  const sections = links
    .map((l) => document.getElementById(l.dataset.anchor!))
    .filter((el): el is HTMLElement => el !== null);

  const rail = document.querySelector<HTMLElement>('.anchors ul');

  if (sections.length) {
    /**
     * Traz a pílula ativa para dentro da régua mexendo APENAS no scrollLeft
     * dela.
     *
     * Aqui havia um `scrollIntoView`, e era bug de rolagem: por especificação
     * ele rola toda a cadeia de ancestrais, não só o contêiner rolável mais
     * próximo — e o observer o chamava dezenas de vezes por gesto de scroll.
     * Rolagem programática durante uma rolagem suave em curso cancela ou
     * atropela a animação — e o `scroll-behavior: smooth` que existia no
     * `html` saiu junto, pelo mesmo motivo (ver global.css). Mexer no
     * scrollLeft de um elemento não tem como afetar a rolagem da página.
     */
    const revelarPilula = (link: HTMLAnchorElement) => {
      if (!rail || rail.scrollWidth <= rail.clientWidth) return;
      const pill = link.getBoundingClientRect();
      const box = rail.getBoundingClientRect();
      const folga = 16;
      if (pill.left < box.left) {
        rail.scrollLeft -= box.left - pill.left + folga;
      } else if (pill.right > box.right) {
        rail.scrollLeft += pill.right - box.right + folga;
      }
    };

    let atual: string | null = null;

    const setActive = (id: string | null) => {
      // O observer dispara muitas vezes por gesto; sem esta guarda o trabalho
      // todo se repetia a cada disparo.
      if (id === atual) return;
      atual = id;

      for (const l of links) {
        const on = l.dataset.anchor === id;
        if (on) l.dataset.active = 'true';
        else delete l.dataset.active;
      }

      const active = links.find((l) => l.dataset.anchor === id);
      if (active) revelarPilula(active);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length) setActive(visible[0]!.target.id);
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );

    for (const s of sections) observer.observe(s);
  }
</script>
