{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker só de assets estáticos: NÃO existe "main" de propósito.
  //
  // Sem este arquivo no repo, `wrangler deploy` detectava Astro, rodava
  // `astro add cloudflare` DENTRO do build e convertia o site em Worker SSR —
  // mudando `output: 'static'` para server, exigindo binding KV "SESSION" e
  // arrastando o `node:fs` do Photo.astro/Depoimentos.astro para o runtime.
  // O site é estático por decisão de projeto; com config presente o wrangler
  // pula o onboarding e só publica o `dist`.
  //
  // O nome tem de casar com o Worker do painel (institutosanzia), senão o
  // deploy falha na validação de nome.
  "name": "institutosanzia",
  "compatibility_date": "2026-09-08",

  "assets": {
    "directory": "./dist",

    // O build usa `format: 'file'` + `trailingSlash: 'never'`, então o dist é
    // uma lista plana de .html. "auto-trailing-slash" serve
    // /cuidado-psicologico a partir de cuidado-psicologico.html e redireciona
    // a versão com barra — que é exatamente o combinado no astro.config.
    "html_handling": "auto-trailing-slash",

    // Serve o dist/404.html com status 404 de verdade.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
